config ui 'main'
	option enabled '1'
	option framebuffer '/dev/fb0'
	option touch_device 'auto'
	option brightness '128'
	option dimmed_brightness '64'
	# Display-engine picture 0..100, 50 neutral (Settings > Picture).
	option lcd_bright '50'
	option lcd_contrast '50'
	option lcd_hue '50'
	option lcd_saturation '50'

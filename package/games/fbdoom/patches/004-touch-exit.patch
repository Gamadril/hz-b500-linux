 static int kbd[8];
 static int kbd_count;
 
+/* Exit without a keyboard: hold the top-left EXIT_ZONE x EXIT_ZONE screen
+   pixels for EXIT_HOLD_MS. Touch maps like the HMI: the raw range spans the
+   whole screen, no axis swap. */
+#define EXIT_ZONE    100
+#define EXIT_HOLD_MS 2000
+extern struct fb_var_screeninfo fb;
+static int touch = -1;
+static int touch_x, touch_y, touch_down, hold_start = -1;
+static struct input_absinfo touch_xr, touch_yr;
+
+static int touch_pixel(int value, const struct input_absinfo *range, int extent)
+{
+    return (long long)(value - range->minimum) * (extent - 1) /
+           (range->maximum - range->minimum);
+}
+
+static void touch_poll(void)
+{
+    struct input_event ev;
+    int in_zone;
+
+    if (touch < 0)
+        return;
+    while (read(touch, &ev, sizeof(ev)) == sizeof(ev)) {
+        if (ev.type == EV_KEY && ev.code == BTN_TOUCH)
+            touch_down = ev.value;
+        else if (ev.type == EV_ABS && ev.code == ABS_MT_POSITION_X)
+            touch_x = ev.value;
+        else if (ev.type == EV_ABS && ev.code == ABS_MT_POSITION_Y)
+            touch_y = ev.value;
+    }
+    /* Checked every tic: a resting finger may send no events. */
+    in_zone = touch_down &&
+              touch_pixel(touch_x, &touch_xr, fb.xres) < EXIT_ZONE &&
+              touch_pixel(touch_y, &touch_yr, fb.yres) < EXIT_ZONE;
+    if (!in_zone) {
+        hold_start = -1;
+    } else if (hold_start < 0) {
+        hold_start = I_GetTimeMS();
+    } else if (I_GetTimeMS() - hold_start >= EXIT_HOLD_MS) {
+        printf("Touch exit.\n");
+        I_Quit();
+    }
+}
+
 void kbd_shutdown(void)
 {
     while (kbd_count)

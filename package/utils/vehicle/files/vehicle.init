#!/bin/sh /etc/rc.common
USE_PROCD=1
START=55
STOP=08
start_service() {
    config_load vehicle
    local enabled device interface baud attach media fuel_capacity speed_clock
    config_get_bool enabled main enabled 1
    [ "$enabled" = 1 ] || return 0
    config_get device main device /dev/ttyS3
    config_get interface main interface can0
    config_get baud main baud 750000
    config_get_bool attach main attach_slcan 1
    config_get_bool media main media_keys 1
    config_get fuel_capacity main fuel_capacity_litres 63
    config_get speed_clock main speed_clock_hz 4000
    local timezone
    timezone="$(uci -q get system.@system[0].timezone)"
    # glibc uses TZ or /etc/localtime; /etc/TZ alone is insufficient.
    [ -n "$timezone" ] || timezone=UTC0
    if [ "$attach" = 1 ]; then
        procd_open_instance slcan
        procd_set_param command /usr/bin/vehicle-slcan --device "$device" --interface "$interface" --baud "$baud"
        procd_set_param respawn 3600 5 0
        procd_set_param stderr 1
        procd_close_instance
    fi
    procd_open_instance data
    procd_set_param command /usr/bin/vehicled --interface "$interface" --fuel-capacity-litres "$fuel_capacity" --speed-clock-hz "$speed_clock"
    procd_set_param env "TZ=$timezone"
    procd_set_param respawn 3600 5 0
    procd_set_param stderr 1
    procd_set_param file /etc/config/vehicle
    procd_close_instance
    if [ "$media" = 1 ]; then
        procd_open_instance media
        procd_set_param command /usr/bin/vehicle-watch --media-uinput
        procd_set_param respawn 3600 5 0
        procd_set_param stderr 1
        procd_close_instance
    fi
}

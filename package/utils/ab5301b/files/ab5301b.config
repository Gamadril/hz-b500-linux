config companion 'audio'
	option enabled '1'
	option device '/dev/ttyS4'
	option volume '18'
	option speaker '0'
	option mute '0'
	# Tested local playback mode; applied before the speaker/unmute settings.
	option source 'sd'
	# Captured board templates; commands preserve fields other than named controls.
	option aa_template '0000070700000a011200'
	option b8_template '03838000040001'

config companion 'bluetooth'
	# 0 sends AT#CD+AT#CB (disconnect, not connectable, still discoverable),
	# 1 AT#CA+AT#CC (connectable, reconnect last). Re-sent on IS and MCU reset,
	# before the source restore. Wireless AA needs power '1'.
	option power '0'
	# Wireless-AA bridge socket (/var/run/ab5301b.sock.bt); does not expose Linux
	# Bluetooth HCI. On by default so the AA tile never restarts the service (a
	# restart loses the phone name/track reports). Idle unless a receiver connects.
	option enabled '1'
	# Always sent as AT#MM on startup/IS (radio keeps the last name otherwise).
	# Settings > Connections edits it; 1-16 printable characters, no spaces.
	option local_name 'SWL-BT'
	# Empty preserves the radio's PIN; digits only if explicitly configured.
	option pin ''

#!/bin/sh /etc/rc.common
USE_PROCD=1
START=51
STOP=09

start_service() {
	[ -e /sys/firmware/devicetree/base/soc@3000000/sound@2030340/allwinner,fixed-headphone-output ] || return 0
	config_load ab5301b
	local enabled device volume speaker mute source aa_template b8_template
	local bluetooth local_name pin power
	config_get_bool enabled audio enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get device audio device /dev/ttyS4
	config_get volume audio volume 18
	config_get_bool speaker audio speaker 0
	config_get_bool mute audio mute 0
	config_get source audio source sd
	config_get aa_template audio aa_template 0000070700000a011200
	config_get b8_template audio b8_template 03838000040001
	config_get_bool bluetooth bluetooth enabled 0
	config_get local_name bluetooth local_name SWL-BT
	config_get pin bluetooth pin ''
	config_get_bool power bluetooth power 0
	procd_open_instance
	procd_set_param command /usr/bin/ab5301b --device "$device" \
		--volume "$volume" --speaker "$speaker" --mute "$mute" --source "$source" \
		--aa-template "$aa_template" --b8-template "$b8_template" \
		--bluetooth "$bluetooth" --bt-name "$local_name" --bt-pin "$pin" \
		--bt-power "$power" serve
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/ab5301b
	procd_close_instance
}

stop_service() {
	# Best effort companion mute before procd terminates it; F133 stops at S50.
	/usr/bin/ab5301b mute on >/dev/null 2>&1 || :
}
